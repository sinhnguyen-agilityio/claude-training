# Two rules for the branches being pushed. Git writes one line per ref to stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
# The remote ref is checked, so `git push origin HEAD:main` and deleting main are caught too.
#   1. Never push to a protected branch.
#   2. A branch name must match the convention in WORKFLOW.md (rule 2), checked by
#      .claude/hooks/convention.mjs. Tags and other non-branch refs are not checked, and neither
#      is deleting a branch, so an old branch with a non-matching name can still be removed.
convention="$(dirname "$0")/../.claude/hooks/convention.mjs"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "Cannot push to protected branch \"${remote_ref#refs/heads/}\". Push a feature branch and open a pull request." >&2
      exit 1
      ;;
    refs/heads/*)
      if [ "$local_sha" != "$zero" ]; then
        node "$convention" branch "${remote_ref#refs/heads/}" || status=1
      fi
      ;;
  esac
done
exit $status
