# Never commit directly on a protected branch. Git runs this hook in the checkout or worktree that
# is being committed to, so it sees the real branch however the command was written. A detached
# HEAD (rebase, cherry-pick) is allowed.
branch=$(git symbolic-ref --short -q HEAD)
case "$branch" in
  main | master)
    echo "Cannot commit directly on protected branch \"$branch\". Create a feature branch first." >&2
    exit 1
    ;;
esac

# Run each check only when its files are staged.
staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q -v '^\.claude/'; then
  pnpm exec lint-staged --max-arg-length 4000
fi

if echo "$staged" | grep -q '^\.claude/'; then
  node --test .claude/hooks/*.test.mjs
fi
