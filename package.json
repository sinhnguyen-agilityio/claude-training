{
  "name": "user-management-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @app/web dev",
    "build": "pnpm --filter @app/web build",
    "preview": "pnpm --filter @app/web preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @app/web test",
    "test:watch": "pnpm --filter @app/web test:watch",
    "test:coverage": "pnpm --filter @app/web test:coverage",
    "e2e": "pnpm --filter @app/web e2e",
    "e2e:ui": "pnpm --filter @app/web e2e:ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "@types/node": "^24.13.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  }
}
