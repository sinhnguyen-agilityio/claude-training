# Local Postgres (pnpm db:up). On Vercel, DATABASE_URL comes from the Neon integration and is the
# pooled connection string, shaped like postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require
# Never put that real value in a file that is committed.
DATABASE_URL=postgres://app:app@localhost:5432/users_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=users_dev
# POST /api/reset restores the 25 seed users and wipes all shared data. Leave it false (or unset);
# set it to true only on the demo, where the Reset button needs it. Without it the route answers 404.
ALLOW_RESET=false
