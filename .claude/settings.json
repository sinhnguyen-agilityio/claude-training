{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('url').pathToFileURL(require('path').join(process.env.CLAUDE_PROJECT_DIR,process.argv[1])).href)).catch(e=>{console.error('Hook error ('+process.argv[1]+'): '+e.message);process.exit(+process.argv[2])})\" .claude/hooks/block-forbidden.mjs 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('url').pathToFileURL(require('path').join(process.env.CLAUDE_PROJECT_DIR,process.argv[1])).href)).catch(e=>{console.error('Hook error ('+process.argv[1]+'): '+e.message);process.exit(+process.argv[2])})\" .claude/hooks/notify-on-finish.mjs 1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"Promise.resolve().then(()=>import(require('url').pathToFileURL(require('path').join(process.env.CLAUDE_PROJECT_DIR,process.argv[1])).href)).catch(e=>{console.error('Hook error ('+process.argv[1]+'): '+e.message);process.exit(+process.argv[2])})\" .claude/hooks/prettier-user-management.mjs 1"
          }
        ]
      }
    ]
  }
}
